<?xml version="1.0" encoding="UTF-8"?>
<analysisEngineDescription xmlns="http://uima.apache.org/resourceSpecifier">
  <frameworkImplementation>org.apache.uima.java</frameworkImplementation>
  <primitive>false</primitive>
  <delegateAnalysisEngineSpecifiers>
    <delegateAnalysisEngine key="TokenEnhancer">
      <import location="../enhancers/TokenEnhancer.xml"/>
    </delegateAnalysisEngine>
    <delegateAnalysisEngine key="vislcg3NounsInsEnhancer">
      <import location="../enhancers/vislcg3NounsInsEnhancer.xml"/>
    </delegateAnalysisEngine>
  </delegateAnalysisEngineSpecifiers>
  <analysisEngineMetaData>
    <name>vislcg3PostProc_NounsIns</name>
    <description/>
    <version>1.0</version>
    <vendor/>
    <configurationParameters searchStrategy="language_fallback">
      <configurationParameter>
        <name>Tags</name>
        <description>A list of tags to mark up, comma separated</description>
        <type>String</type>
        <multiValued>false</multiValued>
        <mandatory>true</mandatory>
        <overrides>
          <parameter>TokenEnhancer/Tags</parameter>
        </overrides>
      </configurationParameter>
      <configurationParameter>
        <name>NInsTags</name>
        <description>A comma-separated list of instrumental noun tags.</description>
        <type>String</type>
        <multiValued>false</multiValued>
        <mandatory>true</mandatory>
        <overrides>
          <parameter>vislcg3NounsInsEnhancer/NInsTags</parameter>
        </overrides>
      </configurationParameter>
    </configurationParameters>
    <configurationParameterSettings>
     <!--  <nameValuePair>
        <name>Tags</name>
        <value>
          <string>blah,blubb</string>
        </value>
      </nameValuePair> --> 
        <nameValuePair>
        <name>Tags</name>
        <value>
          <string>N Fem Anim Sg Ins, N Fem Inan Sg Ins, N Msc Anim Sg Ins, N Msc Inan Sg Ins, N Neu Anim Sg Ins, N Neu Inan Sg Ins, N Fem Anim Pl Ins, N Fem Inan Pl Ins, N Msc Anim Pl Ins, N Msc Inan Pl Ins, N Neu Anim Pl Ins, N Neu Inan Pl Ins</string>
        </value>
      </nameValuePair>
    </configurationParameterSettings>
    <flowConstraints>
      <fixedFlow>
        <node>TokenEnhancer</node>
        <node>vislcg3NounsInsEnhancer</node>
      </fixedFlow>
    </flowConstraints>
    <fsIndexCollection/>
    <capabilities>
      <capability>
        <inputs>
          <type allAnnotatorFeatures="true">werti.uima.types.annot.CGToken</type>
        </inputs>
        <outputs>
          <type allAnnotatorFeatures="true">werti.uima.types.Enhancement</type>
          <type allAnnotatorFeatures="true">werti.uima.types.annot.CGToken</type>
        </outputs>
        <languagesSupported/>
      </capability>
    </capabilities>
    <operationalProperties>
      <modifiesCas>true</modifiesCas>
      <multipleDeploymentAllowed>true</multipleDeploymentAllowed>
      <outputsNewCASes>false</outputsNewCASes>
    </operationalProperties>
  </analysisEngineMetaData>
  <resourceManagerConfiguration/>
</analysisEngineDescription>
