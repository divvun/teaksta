platforms (
    {
        platform "rust"
        files (crates/**/*.rs Cargo.toml crates/**/Cargo.toml)
        checks {
            format {
                cmd "cargo fmt --check"
                fix "cargo fmt"
            }
            lint {
                cmd "cargo check --workspace"
            }
            test {
                cmd "cargo test --workspace"
            }
        }
    }
)

commit {
    type-prefix "required"
}

adoption {
    scope "porting"
}
