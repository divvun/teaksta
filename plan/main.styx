name teaksta

source {
    url "git@github.com:divvun/teaksta.git"
    ref main
}

children (
    {
        id runtime
        title "divvun-runtime integration"
        kind @feat
        children (
            {
                id sme-bundle
                title "Author the sme .drb bundle: tokenize/analyze/generate/sentences named pipelines"
                sealed true
                log (
                    {
                        at 2026-09-10T12:59:00.68822Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-09-10T13:11:33.194802Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }
        )
    }

    {
        id server
        title "Backend service (poem)"
        kind @feat
        children (
            {
                id router-binary
                title "Poem router + server binary wiring the translated handlers"
                sealed true
                log (
                    {
                        at 2026-09-10T13:39:31.548268Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id json-api
                title "JSON enhancement API endpoint (the add-on protocol contract)"
                deps (router-binary)
                sealed true
                log (
                    {
                        at 2026-09-10T14:28:46.845008Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }
        )
    }

    {
        id frontend
        title "Dioxus web frontend"
        kind @feat
        children (
            {
                id dioxus-shell
                title "Dioxus app shell: site chrome, activity picker, URL form"
                sealed true
                log (
                    {
                        at 2026-09-10T13:39:33.856902Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id exercise-colorize-click
                title "Colorize and click exercise modes"
                deps (dioxus-shell json-api)
                sealed true
                log (
                    {
                        at 2026-09-10T15:36:45.851652Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id exercise-mc
                title "Multiple-choice exercise mode (distractor selects)"
                deps (dioxus-shell json-api)
                sealed true
                log (
                    {
                        at 2026-09-10T14:49:32.523683Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-09-10T15:36:49.024328Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id exercise-cloze
                title "Cloze exercise mode (hints, parallel-form answers)"
                deps (dioxus-shell json-api)
                sealed true
                log (
                    {
                        at 2026-09-10T14:49:41.029218Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Todo → Doing (nplan start)"
                    }

                    {
                        at 2026-09-10T15:40:26.642358Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }
        )
    }

    {
        id port-completion
        title "Port completion (idiomatize)"
        kind @refactor
        children (
            {
                id idiomatize-enhancers
                title "Consolidate the six enhancer clones (Word/SpanTag) into one parameterized enhancer"
                sealed true
                log (
                    {
                        at 2026-09-10T13:39:39.246331Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id fix-legacy-quirks
                title "Fix documented legacy quirks as visible spec-rule changes"
                kind @fix
                deps (idiomatize-enhancers)
                sealed true
                log (
                    {
                        at 2026-09-10T15:40:35.910771Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }
        )
    }

    {
        id dejavaize
        title "De-Javaization: idiomatic Rust throughout"
        kind @refactor
        children (
            {
                id dj-core
                title "Idiomatic enhancer core: burn jstring, Java types, and the wertiview vocabulary"
                sealed true
                log (
                    {
                        at 2026-09-10T18:49:41.023667Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id dj-annotate
                title "DOM-native annotation mapping replacing the e-tag/sentinel protocol"
                sealed true
                log (
                    {
                        at 2026-09-10T18:49:42.418061Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id dj-server
                title "Native poem server: no servlet cosplay, no wait page, analyzer language gate"
                deps (dj-annotate)
                sealed true
                log (
                    {
                        at 2026-09-10T20:05:46.81519Z
                        author "brendan@bbqsrc.net"
                        kind @status
                        text "Doing → Done (nplan complete)"
                    }
                )
            }

            {
                id dj-frontend
                title "Frontend on the teaksta vocabulary and /api endpoints"
                deps (dj-core dj-server)
            }
        )
    }
)
